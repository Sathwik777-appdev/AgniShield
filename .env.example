# AgniShield Environment Configuration
# Copy to .env and fill in your values for local or production deployment.

# PostgreSQL Connection
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=agnishield_user
PG_PASSWORD=change_me_in_production
PG_DB=agnishield_db

# Comma-separated allowed CORS origins (tunnel & chrome-extension:// are matched via regex)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Rate Limiting
RATE_LIMIT_ENABLED=true
